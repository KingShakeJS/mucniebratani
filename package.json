{
  "name": "social-network-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"pnpm --filter @social/server dev\" \"pnpm --filter @social/client dev\"",
    "dev:server": "pnpm --filter @social/server dev",
    "dev:client": "pnpm --filter @social/client dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "10.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
